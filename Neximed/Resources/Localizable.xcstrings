{
  "sourceLanguage" : "es",
  "strings" : {
    "Bienvenido a Neximed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Neximed" } }
      }
    },
    "Tu cuaderno clínico personal y preparador de consultas médicas. 100% privado y on-device." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your personal clinical notebook and medical visit preparer. 100% private and on-device." } }
      }
    },
    "Comenzar con Neximed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Get started with Neximed" } }
      }
    },
    "Continuar" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Continue" } }
      }
    },
    "Habla, Neximed escucha" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Speak, Neximed listens" } }
      }
    },
    "Dicta tus síntomas con voz natural. La IA on-device pule la redacción y extrae los datos clave." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictate your symptoms with natural voice. On-device AI polishes the text and extracts key data." } }
      }
    },
    "Escanea tus analíticas" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan your lab results" } }
      }
    },
    "Fotografía tu analítica de laboratorio y Neximed extrae y organiza más de 25 biomarcadores." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Photograph your lab report and Neximed extracts and organizes over 25 biomarkers." } }
